# ============================================
# Telegram Bot Configuration
# ============================================

# REQUIRED: Bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# REQUIRED: Admin Telegram username (without @)
ADMIN_USERNAME=your_admin_username

# ============================================
# Order Routing — target chat IDs for each document type
# These are Telegram chat/group IDs where manager receives orders
# Format: integer (use "-" prefix for groups/supergroups)
# ============================================
ROUTING_demo_service=-100123456789
ROUTING_demo_document=-100987654321
ROUTING_demo_check=123456789
ROUTING_APOSTILLE=-100123456788
ROUTING_DEFAULT=555555555

# ============================================
# Payment Details — shown to customer after order
# Override business_config defaults if needed
# ============================================
# PAYMENT_CARD="Bank transfer details..."
# PAYMENT_CRYPTO="USDT address..."
# PAYMENT_ONLINE="Online payment link..."

# ============================================
# Database
# ============================================
# Supported: sqlite:///bot.db, postgresql://user:pass@host/db, mysql://...
DATABASE_URL=sqlite:///bot.db

# ============================================
# Redis (optional — for production FSM storage)
# ============================================
# REDIS_URL=redis://localhost:6379/0